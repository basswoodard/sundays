# Copy to .env and fill in for local dev. For a real deploy, set these as
# your host's environment variables instead of committing a .env file.

# Local dev (default): a plain sqlite file, no account needed.
DATABASE_URL="file:./sundays.db"
# TURSO_AUTH_TOKEN=            # leave unset for local dev

# Production (Turso free tier): swap DATABASE_URL for the libsql:// URL Turso
# gives you and set TURSO_AUTH_TOKEN to its auth token. Same app code, same
# `npx drizzle-kit push` command — see README.md "Deploying for free".
# DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="ey..."

# Signs and verifies session cookies (jose/JWT). Must be a long random
# string, and must stay the same across restarts/deploys or every existing
# session cookie is invalidated. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-value"
